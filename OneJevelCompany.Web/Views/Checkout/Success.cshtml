@model OneJevelsCompany.Core.Entities.Order

@{
    ViewData["Title"] = "Order Successful";
}

<div class="max-w-5xl mx-auto text-center py-16 px-4">

    <h2 class="text-3xl font-bold text-amber-600 mb-4">
        Thank you for your purchase!
    </h2>

    <p class="text-gray-700 mb-6">
        Your order #@Model.Id has been successfully placed.
    </p>

    <p class="text-gray-700 mb-8">
        Your order has been received and will be prepared with care
        <span class="text-amber-600">◇</span>
    </p>

    <div class="w-full max-w-4xl mx-auto mb-8 overflow-hidden rounded-lg">
        <img src="~/images/OrderSuccessPackaging.jpg"
             alt="Your jewellery order being carefully packaged"
             class="w-full h-80 object-cover" />
    </div>

    <a href="/"
       class="inline-block bg-amber-600 text-white px-6 py-3 rounded hover:bg-amber-500 transition">
        Return Home
    </a>

</div>