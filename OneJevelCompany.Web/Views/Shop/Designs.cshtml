@model IEnumerable<object>

@{
    ViewData["Title"] = "Designs";

    string? S(object o, string name)
    {
        if (o is null)
        {
            return null;
        }

        var p = o.GetType().GetProperty(name);

        if (p == null)
        {
            return null;
        }

        var v = p.GetValue(o);

        return v?.ToString();
    }

    int I(object o, string name, int fallback = 0)
    {
        var s = S(o, name);

        if (int.TryParse(s, out var n))
        {
            return n;
        }

        return fallback;
    }

    (string title, string? thumb, string category, int popularity, string? href) Pick(object item)
    {
        var thumb = S(item, "ThumbUrl")
                 ?? S(item, "PreviewDataUrl")
                 ?? S(item, "ImageUrl")
                 ?? S(item, "DataUrl");

        var title = S(item, "Title")
                 ?? S(item, "Name")
                 ?? "Custom design";

        var category = S(item, "Category")
                    ?? S(item, "CategoryName")
                    ?? "Bracelet";

        var popularity = I(
            item,
            "Popularity",
            I(item, "Orders", 0));

        var href = S(item, "DetailsUrl");

        return (
            title!,
            thumb,
            category!,
            popularity,
            href);
    }
}

<div class="max-w-5xl mx-auto px-4 py-8">

    <div class="text-center mb-8">
        <h1 class="text-3xl font-semibold text-amber-700">
            Our Best Designs
        </h1>

        <p class="mt-2 text-gray-600">
            Ready-made designs and community submissions.
        </p>
    </div>

    @if (Model == null || !Model.Any())
    {
        <div class="bg-white border rounded-2xl p-8 text-center text-gray-600">
            No designs yet.

            Create one in the
            <a asp-controller="Shop"
               asp-action="Design"
               class="text-amber-700 underline">
                Design Studio
            </a>.
        </div>
    }
    else
    {
        <div class="grid grid-cols-1 md:grid-cols-2 gap-8 max-w-4xl mx-auto">

            @foreach (var item in Model)
            {
                var d = Pick(item);

                <div class="bg-white rounded-2xl overflow-hidden shadow border border-gray-100">

                    <div class="bg-gray-100 h-72 overflow-hidden flex items-center justify-center">

                        @if (!string.IsNullOrWhiteSpace(d.thumb))
                        {
                            <img src="@d.thumb"
                                 alt="@d.title"
                                 class="w-full h-full object-cover" />
                        }
                        else
                        {
                            <div class="text-gray-400 text-sm">
                                No preview
                            </div>
                        }

                    </div>

                    <div class="p-5">

                        <div class="flex items-start justify-between gap-4">

                            <h3 class="text-lg font-semibold">
                                @d.title
                            </h3>

                            <span class="text-xs px-3 py-1 rounded-full bg-amber-50 text-amber-700 border border-amber-100 whitespace-nowrap">
                                @d.category
                            </span>

                        </div>

                        <div class="mt-3 text-sm text-gray-600">
                            Popularity:
                            <strong>@d.popularity</strong>
                        </div>

                        @if (!string.IsNullOrWhiteSpace(d.href))
                        {
                            <div class="mt-4">

                                <a href="@d.href"
                                   class="text-sm text-amber-700 hover:underline">
                                    View details
                                </a>

                            </div>
                        }

                    </div>

                </div>
            }

        </div>
    }

</div>